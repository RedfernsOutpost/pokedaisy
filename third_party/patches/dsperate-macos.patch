DSperate on macOS (Apple Silicon), applied to third_party/dsperate-lr/DSperate by
third_party/patches/apply_dsperate_macos_patch.cmake when building on Apple only:
- crypto/aes.c: no <sys/auxv.h>/getauxval on macOS; every Apple Silicon core has the AES instructions.
- cheat/analog_db.cpp, io/dsi_font.cpp, gpu/gl/gl_shaders.cpp, gpu/vk/vk_shaders.cpp: the .incbin blobs go in
  Mach-O's __TEXT,__const and their symbols carry the leading underscore C names have there.
- gpu/render3d.cpp: Apple clang refuses reinterpret_cast from const void* to a function pointer (const_cast first).
- gpu/kernels_neon.cpp: Apple's vst1_u32 is a macro, so a brace-initialised vector argument needs parentheses.

diff --git a/src/core/cheat/analog_db.cpp b/src/core/cheat/analog_db.cpp
index a3681b9..ce3027e 100644
--- a/src/core/cheat/analog_db.cpp
+++ b/src/core/cheat/analog_db.cpp
@@ -6,12 +6,21 @@
 #include "core/cheat/database.h"
 
 // The directory comes from CMake (DSPERATE_ANALOG_DB_DIR), absolute.
+
+// macOS (Mach-O): read-only data goes in __TEXT,__const and C symbols carry a leading underscore.
+#ifdef __APPLE__
+#define DS_ASM_RODATA "\t.section __TEXT,__const\n"
+#define DS_ASM_SYM(s) "_" s
+#else
+#define DS_ASM_RODATA "\t.section .rodata\n"
+#define DS_ASM_SYM(s) s
+#endif
 __asm__(
-  "\t.section .rodata.dsperate_analog_db,\"a\",%progbits\n"
+  DS_ASM_RODATA
   "\t.balign 4\n"
-  "\t.globl dsperate_analog_db_begin\ndsperate_analog_db_begin:\n"
+  "\t.globl " DS_ASM_SYM("dsperate_analog_db_begin") "\n" DS_ASM_SYM("dsperate_analog_db_begin") ":\n"
   "\t.incbin \"" DSPERATE_ANALOG_DB_DIR "/usrcheat-analog.dat\"\n"
-  "\t.globl dsperate_analog_db_end\ndsperate_analog_db_end:\n"
+  "\t.globl " DS_ASM_SYM("dsperate_analog_db_end") "\n" DS_ASM_SYM("dsperate_analog_db_end") ":\n"
   "\t.previous\n");
 extern "C" const ds::u8 dsperate_analog_db_begin[], dsperate_analog_db_end[];
 
diff --git a/src/core/crypto/aes.c b/src/core/crypto/aes.c
index 0b380eb..c0e7ecf 100644
--- a/src/core/crypto/aes.c
+++ b/src/core/crypto/aes.c
@@ -401,7 +401,9 @@ static void CipherSw(state_t* state, const uint8_t RoundKey[AES_keyExpSize])
  * reader run whole titles through this, a block at a time. */
 #if defined(__aarch64__) && defined(__GNUC__)
 #include <arm_neon.h>
+#ifndef __APPLE__
 #include <sys/auxv.h>
+#endif
 #define HWCAP_AES_BIT (1UL << 3)
 __attribute__((target("+crypto")))
 static void CipherHw(state_t* state, const uint8_t* rk)
@@ -411,7 +413,11 @@ static void CipherHw(state_t* state, const uint8_t* rk)
   s = veorq_u8(vaeseq_u8(s, vld1q_u8(rk + (Nr - 1) * 16)), vld1q_u8(rk + Nr * 16));
   vst1q_u8((uint8_t*)state, s);
 }
+#ifdef __APPLE__
+static int hw_detect(void) { return 1; } /* every Apple Silicon chip has the AES instructions */
+#else
 static int hw_detect(void) { return (getauxval(AT_HWCAP) & HWCAP_AES_BIT) != 0; }
+#endif
 #elif defined(__x86_64__) && defined(__GNUC__)
 #include <wmmintrin.h>
 __attribute__((target("aes,sse2")))
