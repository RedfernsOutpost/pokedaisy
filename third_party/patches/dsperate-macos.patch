 #include <unordered_map>
 #include <unordered_set>
 #include <vector>
@@ -270,4 +273,20 @@ void        jit_h_st32(CpuContext* cpu, u32 addr, u32 v);
 
 inline void sync_icache(u8* start, size_t len) { __builtin___clear_cache(reinterpret_cast<char*>(start), reinterpret_cast<char*>(start + len)); }
 
+// macOS on Apple Silicon: the arena is MAP_JIT memory, which a thread sees either writable or executable, never both
+// (pthread_jit_write_protect_np). Every write to the arena (code, patches, the LUTs at its front) sits in one of these;
+// they nest, and the outermost puts the thread back to executable, so a helper called from translated code returns
+// to code it can run. Elsewhere the arena is plain RWX and this is nothing.
+#if defined(__APPLE__) && defined(__aarch64__)
+struct JitWriteScope {
+  static inline thread_local int depth = 0;
+  JitWriteScope() { if (depth++ == 0) pthread_jit_write_protect_np(0); }
+  ~JitWriteScope() { if (--depth == 0) pthread_jit_write_protect_np(1); }
+  JitWriteScope(const JitWriteScope&) = delete;
+  JitWriteScope& operator=(const JitWriteScope&) = delete;
+};
+#else
+struct JitWriteScope {};
+#endif
+
 } // namespace ds::jit
